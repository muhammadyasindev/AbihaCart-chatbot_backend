{
  "": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/order-confirmation/(.*)",
      "dest": "/order-confirmation/"
    },
    {
      "src": "/order-confirmation",
      "dest": "/order-confirmation/index.html"
    },
    {
      "src": "/widget/(.*)",
      "dest": "/storefront-widget/"
    },
    {
      "src": "/widget",
      "dest": "/storefront-widget/index.html"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
